{
  "name": "habits-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "mocha \"test/unit/**/*.test.js\" --exit",
    "test:unit": "mocha \"test/unit/**/*.test.js\" --exit",
    "test:coverage": "c8 --reporter=text --reporter=html mocha \"test/unit/**/*.test.js\" --exit",
    "test:api": "node scripts/run-api-tests.js",
    "test:api:newman": "newman run postman/HabitsUp.postman_collection.json -e postman/HabitsUp.postman_environment.json -d postman/ddt_habitos.json -r cli,htmlextra --reporter-htmlextra-export ../reports/newman/habitsup-api-report.html",
    "dev": "nodemon src/server.js",
    "swagger": "node swagger.js",
    "swagger:watch": "nodemon --watch src --exec 'npm run swagger'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^8.23.0",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "nodemailer": "^8.0.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "mongodb-memory-server": "^11.4.0",
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.14",
    "sinon": "^22.1.0",
    "swagger-autogen": "^2.23.7"
  },
  "description": ""
}
